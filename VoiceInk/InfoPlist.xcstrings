    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "술술 benötigt Zugriff auf Ihr Mikrofon, um Audio für die Transkription aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulsul needs access to your microphone to record audio for transcription."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "술술 需要访问麦克风以录制音频用于转录。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "술술 a besoin d'accéder à votre microphone pour enregistrer l'audio à des fins de transcription."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "술술이 받아쓰기용 오디오를 녹음하려면 마이크 접근이 필요합니다."
          }
        }
      }
    },
    "NSScreenCaptureUsageDescription" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "술술 benötigt Zugriff auf die Bildschirmaufnahme, um Kontext von Ihrem Bildschirm für eine höhere Transkriptionsgenauigkeit zu erfassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulsul needs screen recording access to understand context from your screen for improved transcription accuracy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "술술 需要屏幕录制权限以理解屏幕上的上下文，提高转录准确性。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "술술 a besoin d'un accès à l'enregistrement d'écran pour comprendre le contexte de votre écran afin d'améliorer la précision de la transcription."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "술술이 화면의 맥락을 파악해 받아쓰기 정확도를 높이려면 화면 기록 접근이 필요합니다."
          }
        }
      }
    }
  },
  "version" : "1.0"
