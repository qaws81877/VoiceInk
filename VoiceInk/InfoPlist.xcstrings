    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "술술 muss mit Ihrem Browser interagieren, um die aktuelle Website zu erkennen und website-spezifische Konfigurationen anzuwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulsul needs to interact with your browser to detect the current website for applying website-specific configurations."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "술술 需要与浏览器交互以检测当前网站，从而应用针对特定网站的配置。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "술술 doit interagir avec votre navigateur pour détecter le site Web actuel afin d'appliquer des configurations spécifiques au site Web."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "술술이 현재 웹사이트를 감지해 사이트별 설정을 적용하려면 브라우저와 상호작용해야 합니다."
          }
        }
      }
    },
